{
  "package_format": "tin-workflow-package-v1",
  "definition": {
    "key": "growth.activation_rescue",
    "title": "Find the activation leak and build one rescue campaign",
    "description": "Identify the highest-leverage activation drop-off in a supplied signup cohort and produce one evidence-backed rescue campaign brief.",
    "executor": "codex.procedure",
    "version": "1.0.0",
    "schedule_modes": [
      "on_demand",
      "weekly"
    ],
    "input_schema": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "project_id",
        "cohort_file",
        "activation_event"
      ],
      "properties": {
        "project_id": {
          "type": "string",
          "format": "uuid"
        },
        "cohort_file": {
          "type": "string",
          "title": "Signup cohort CSV",
          "maxLength": 300,
          "description": "Project-relative path to a CSV containing signup and product-event evidence."
        },
        "activation_event": {
          "type": "string",
          "title": "Activation event",
          "maxLength": 200,
          "description": "The single product event that represents first meaningful value."
        },
        "activation_window_days": {
          "type": "integer",
          "title": "Activation window (days)",
          "minimum": 1,
          "maximum": 30,
          "default": 7
        },
        "trigger_context": {
          "type": "string",
          "title": "Why run this now?",
          "maxLength": 2000,
          "default": "",
          "x-tin-ui": {
            "control": "textarea",
            "order": 40
          }
        }
      }
    },
    "procedure": {
      "prompt_path": "PROMPT.md",
      "skills_path": "skills",
      "skill_files": [
        "skills/activation-rescue/SKILL.md"
      ],
      "entry_skill": "activation-rescue",
      "workspace": {
        "kind": "project.state"
      },
      "sandbox": {
        "profile": "isolated",
        "egress": "fenced",
        "timeout_seconds": 900
      },
      "output": {
        "kind": "project.artifact",
        "path": "reports/ACTIVATION_RESCUE.md",
        "media_type": "text/markdown",
        "max_bytes": 120000
      }
    }
  }
}